# ===========================================================================
# Resume Screening Agent — Configuration
# ===========================================================================

# Optional: LLM Qualitative Critique API Key (Google Gemini or OpenAI)
# When provided, the agent generates qualitative recruiter executive summaries.
# When omitted, the agent runs in 100% offline mode with deterministic scoring.
GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Server & File Upload Limits
PORT=8000
HOST=0.0.0.0
MAX_FILE_SIZE_MB=10
ENVIRONMENT=development

# Scoring Weights (must sum to 1.0)
WEIGHT_SEMANTIC=0.45
WEIGHT_SKILLS=0.35
WEIGHT_EXPERIENCE=0.20
