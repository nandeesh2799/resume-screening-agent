# No external API keys are required for the default configuration.
# The app uses local sentence-transformers (all-MiniLM-L6-v2) for semantic scoring.

# Optional: Increase this to allow larger file uploads (default 10 MB per file)
MAX_FILE_SIZE_MB=10

# Optional: Port for the backend server (default 8000)
PORT=8000

# Optional: Set to "production" to serve the built React app from the backend
ENVIRONMENT=development
